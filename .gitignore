# 依赖
node_modules/
vendor/

# 环境变量(绝对不能进仓库)
.env
.env.local
.env.*.local
config/secrets.*

# 数据文件(题库、用户数据等)
data/*.json
data/*.db
data/*.sqlite
data/uploads/
!data/disposable_domains.txt
!data/.gitkeep

# 日志
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 构建产物(前端 dist 是临时的,但 public 是要入库的)
dist/
build/
.next/
.nuxt/

# IDE / 系统
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# PM2
.pm2/

# 测试覆盖率
coverage/
.nyc_output/
uploads/screenshots/*
!uploads/screenshots/.gitkeep
tessdata/
