# ============================================================
# 汽水音乐互推平台 - 环境变量模板
# 复制本文件为 .env 并填入真实值,.env 不入库
# ============================================================

# 服务端口
PORT=3201

# 运行环境
NODE_ENV=production

# ============================================================
# 数据库(MySQL / MariaDB)
# ============================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=qishui
DB_PASSWORD=请填数据库密码
DB_NAME=qishui_mutual_promotion

# ============================================================
# QQ 邮箱 SMTP(发送验证码用)
# 拿授权码的步骤:
# 1. 登录 mail.qq.com
# 2. 设置 → 账户 → 开启「IMAP/SMTP 服务」
# 3. 短信验证后得到 16 位授权码
# 注意:不是你 QQ 邮箱的登录密码!
# ============================================================
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASS=16位授权码
SMTP_FROM_NAME=汽水音乐互推平台

# ============================================================
# 安全
# ============================================================
# bcrypt 加密轮数,10-12 之间(越大越慢但越安全)
BCRYPT_ROUNDS=10

# IP 哈希用的盐,生产环境一定要改成随机字符串
IP_HASH_SALT=请改成32位以上的随机字符串例如abc123xyz789

# ============================================================
# 业务参数
# ============================================================
# 新用户初始积分
INITIAL_POINTS=100

# 新用户初始信用分
INITIAL_CREDIT=600

# 邮箱验证码有效期(分钟)
EMAIL_CODE_TTL_MINUTES=30

# 同一邮箱验证码请求间隔(秒,防刷)
EMAIL_CODE_COOLDOWN_SECONDS=60
